# Backend-only credentials. Set values in the runtime environment or GitHub Actions secrets.
# Never embed GEMINI_API_KEY in the Android/Flutter client or commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=45

# Required whenever GEMINI_API_KEY is set, to prevent anonymous quota usage.
SHIA_API_TOKEN=

# Comma-separated allowed browser origins. Native clients do not need CORS.
SHIA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=0.0.0.0
PORT=8000
