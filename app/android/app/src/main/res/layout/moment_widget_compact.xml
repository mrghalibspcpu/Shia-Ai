<?xml version="1.0" encoding="utf-8"?>
<!-- Small footprint (about 2x1): the saying only, still on the 3D slab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="11dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="آیت / فرمانِ ساعت"
            android:textColor="#FFE2AF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/moment_widget_orb"
            android:contentDescription="اگلا قول"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFF7E0" />
    </LinearLayout>

    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:lineSpacingExtra="3dp"
        android:maxLines="3"
        android:shadowColor="#AA000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#D8C491"
        android:textDirection="anyRtl"
        android:textSize="9.5sp" />
</LinearLayout>
