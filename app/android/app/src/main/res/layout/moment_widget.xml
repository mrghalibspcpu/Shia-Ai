<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="آیت / فرمانِ ساعت"
            android:textColor="#FFE2AF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="اگلا قول"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFE2AF" />
    </LinearLayout>

    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:lineSpacingExtra="3dp"
        android:maxLines="4"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#C4D3D0"
        android:textDirection="anyRtl"
        android:textSize="11sp" />
</LinearLayout>
