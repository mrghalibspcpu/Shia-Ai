<?xml version="1.0" encoding="utf-8"?>
<!-- Large footprint (4x3 and up): bigger type, an ornament rule and a
     brand footer — the space a reader gives it is actually used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/moment_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦"
            android:textColor="#EBCB85"
            android:textSize="16sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:text="آیت / فرمانِ ساعت"
            android:textColor="#FFE2AF"
            android:textSize="17sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/moment_refresh"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/moment_widget_orb"
            android:contentDescription="اگلا قول"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#FFF7E0" />
    </LinearLayout>

    <TextView
        android:id="@+id/moment_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:lineSpacingExtra="6dp"
        android:maxLines="7"
        android:shadowColor="#AA000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFF9EF"
        android:textDirection="anyRtl"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="✦  ✦  ✦"
        android:textColor="#8FEBCB85"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/moment_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:maxLines="1"
        android:textColor="#D8C491"
        android:textDirection="anyRtl"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="ShiaVerse"
        android:textColor="#77FFE2AF"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
