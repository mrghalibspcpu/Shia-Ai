<?xml version="1.0" encoding="utf-8"?>
<!-- The small plate that carries the next prayer: a gold-edged chip sunk into
     the widget's steel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="90"
                android:centerColor="#1FFFFFFF"
                android:endColor="#0DFFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="#66C9A063" />
        </shape>
    </item>
</layer-list>
