<?xml version="1.0" encoding="utf-8"?>
<!-- The amber lens of the Xplore plate, as a small badge on the widget: a
     glass element in a metal barrel, with the highlight that sits on it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the metal barrel -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:centerColor="#3A474E"
                android:endColor="#10161A"
                android:startColor="#7C8A92"
                android:type="linear" />
        </shape>
    </item>

    <!-- the glass -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.35"
                android:centerY="0.32"
                android:endColor="#180B05"
                android:gradientRadius="60%p"
                android:startColor="#F6C68C"
                android:type="radial" />
        </shape>
    </item>

    <!-- the crescent of light on the glass -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.38"
                android:centerY="0.34"
                android:endColor="#00FFFFFF"
                android:gradientRadius="40%p"
                android:startColor="#CCFFF3DC"
                android:type="radial" />
        </shape>
    </item>

    <!-- the rim of the barrel -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#66D6E2EA" />
        </shape>
    </item>
</layer-list>
