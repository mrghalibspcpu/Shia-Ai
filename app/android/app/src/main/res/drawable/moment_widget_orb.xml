<?xml version="1.0" encoding="utf-8"?>
<!-- The refresh control as a small brass orb: shadow, radial-lit sphere,
     bright rim — tappable depth instead of a flat icon. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="18dp" android:centerX="0.35" android:centerY="0.3" android:startColor="#FFE9B0" android:centerColor="#C69A4B" android:endColor="#6E4E1E" />
            <stroke android:width="1dp" android:color="#FFF3D0" />
        </shape>
    </item>
</layer-list>
