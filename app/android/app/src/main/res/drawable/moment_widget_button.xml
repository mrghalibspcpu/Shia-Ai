<?xml version="1.0" encoding="utf-8"?>
<!-- The refresh button: a round steel knob with its own shadow, a lit top and
     a cool rim, so it reads as a button that can be pressed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the shadow under the knob -->
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#66000000" />
        </shape>
    </item>

    <!-- the knob -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerX="0.34"
                android:centerY="0.28"
                android:endColor="#0C1418"
                android:gradientRadius="70%p"
                android:startColor="#5E727B"
                android:type="radial" />
        </shape>
    </item>

    <!-- the light on the top of the knob -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.34"
                android:centerY="0.26"
                android:endColor="#00FFFFFF"
                android:gradientRadius="45%p"
                android:startColor="#4DFFFFFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- the rim -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#80C9D4DA" />
        </shape>
    </item>
</layer-list>
